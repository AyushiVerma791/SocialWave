# ==============================================================================
# SocialWave Environment Configuration Template
# Copy this file to .env and fill in your actual values.
# NEVER commit your real .env file with production credentials to Git!
# ==============================================================================

# Authentication (JWT)
JWT_SECRET=supersecretjwtkey

# Database Connections (Local Docker Compose)
MONGO_URI_AUTH=mongodb://mongodb:27017/auth-db
MONGO_URI_USER=mongodb://mongodb:27017/user-db
MONGO_URI_POST=mongodb://mongodb:27017/post-db
MONGO_URI_FEED=mongodb://mongodb:27017/feed-db
MONGO_URI_COMMENT=mongodb://mongodb:27017/comment-db
MONGO_URI_FRIEND=mongodb://mongodb:27017/friend-db
MONGO_URI_NOTIFY=mongodb://mongodb:27017/notify-db
MONGO_URI_STORY=mongodb://mongodb:27017/story-db

# Database Connections (Production MongoDB Atlas Template)
# MONGO_URI_AUTH=mongodb+srv://<username>:<password>@cluster0.mongodb.net/auth-db?retryWrites=true&w=majority
# MONGO_URI_USER=mongodb+srv://<username>:<password>@cluster0.mongodb.net/user-db?retryWrites=true&w=majority
# MONGO_URI_POST=mongodb+srv://<username>:<password>@cluster0.mongodb.net/post-db?retryWrites=true&w=majority
# MONGO_URI_FEED=mongodb+srv://<username>:<password>@cluster0.mongodb.net/feed-db?retryWrites=true&w=majority
# MONGO_URI_COMMENT=mongodb+srv://<username>:<password>@cluster0.mongodb.net/comment-db?retryWrites=true&w=majority
# MONGO_URI_FRIEND=mongodb+srv://<username>:<password>@cluster0.mongodb.net/friend-db?retryWrites=true&w=majority
# MONGO_URI_NOTIFY=mongodb+srv://<username>:<password>@cluster0.mongodb.net/notify-db?retryWrites=true&w=majority
# MONGO_URI_STORY=mongodb+srv://<username>:<password>@cluster0.mongodb.net/story-db?retryWrites=true&w=majority

# Media Storage Provider: 'cloudinary' (default) or 's3'
STORAGE_PROVIDER=cloudinary

# Cloudinary Credentials (if STORAGE_PROVIDER=cloudinary)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# AWS S3 Storage (if STORAGE_PROVIDER=s3)
AWS_REGION=us-east-1
S3_BUCKET_NAME=your-socialwave-media-bucket
# CLOUDFRONT_DOMAIN=d123456789.cloudfront.net
